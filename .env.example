# Copy to .env and fill in. .env is never committed (see .gitignore); a real environment variable of the same name wins.
# Used by: clean-clear --suggest-keep VIDEO --srt FILE
# Any service that speaks the OpenAI chat-completions protocol: the request goes to BASE_URL + /chat/completions.
# Its text and the video frames around the credit boundaries are sent to this service: use one you may send them to.

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# optional: a model that reads images, when LLM_MODEL does not (default: LLM_MODEL)
LLM_VISION_MODEL=
# optional: seconds to wait for one answer (default 120)
LLM_TIMEOUT=120
